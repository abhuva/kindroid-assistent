# Required. Never commit the real file.
KINDROID_API_KEY="kn_your_key_here"
KINDROID_GROUP_ID="your_group_id_here"

# Optional participant-chosen next encounters; covers check-ins AND exploration.
RELAY_PARTICIPANT_SCHEDULING="false"
# Optional rooms.example.json-based local file. First group must match above.
# Each assistant room can enable participant_scheduling independently in this file.
RELAY_ROOMS_FILE=""

# Relay behavior
RELAY_POLL_SECONDS="300"
# Empty cycles back off to this interval; activity returns to RELAY_POLL_SECONDS.
RELAY_IDLE_POLL_SECONDS="600"
# Minimum spacing between synchronization/history pages, not reply polling.
RELAY_MIN_HISTORY_INTERVAL_SECONDS="15"
RELAY_MAX_CONSECUTIVE_TURNS="8"
RELAY_MAX_HISTORY_REQUESTS_24H="500"
# Used when a history 429 does not include Retry-After; repeated 429s back off.
RELAY_HISTORY_429_COOLDOWN_SECONDS="3600"
RELAY_MAX_REPLY_CHARS="3500"

# Prefix-based identity plus a brief account-global persona switch around sends.
# Persona IDs are visible in the web app's persona-switch request. The restore
# profile should be the persona you normally use while the relay runs.
RELAY_CODEX_MESSAGE_PREFIX="[CODEX]: "
RELAY_PERSONA_SWITCH_ENABLED="false"
RELAY_CODEX_PERSONA_ID=""
RELAY_CODEX_PERSONA_GENDER="Nonbinary"
RELAY_CODEX_PERSONA_BACKSTORY="Codex Test is an external software agent distinct from Marc."
RELAY_RESTORE_PERSONA_ID=""
RELAY_RESTORE_PERSONA_NAME="Marc"
RELAY_RESTORE_PERSONA_GENDER="Male"
RELAY_RESTORE_PERSONA_BACKSTORY=""

# Initiative check-ins at fixed local wall-clock hours.
RELAY_INITIATIVE_ENABLED="true"
RELAY_INITIATIVE_INTERVAL_SECONDS="600"
RELAY_INITIATIVE_SCHEDULE_HOURS="0,6,12,18"
RELAY_INITIATIVE_JITTER_SECONDS="0"
RELAY_INITIATIVE_MAX_CHECKS_24H="50"
# Optional local-time range, for example: 00:00-08:00
RELAY_INITIATIVE_QUIET_HOURS=""
# Minimum inactivity before scheduled OR manually triggered check-ins (at least 60).
RELAY_INITIATIVE_IDLE_SECONDS="300"

# Optional Codex overrides. Empty uses the local Codex default.
RELAY_CODEX_MODEL=""
RELAY_CODEX_CWD=""
RELAY_APPROVED_SANDBOX="workspace-write"

# Local operational dashboard. Non-loopback hosts are intentionally rejected.
RELAY_WEB_HOST="127.0.0.1"
RELAY_WEB_PORT="8765"
RELAY_WEB_OPEN_BROWSER="false"
RELAY_WEB_POLL_SECONDS="2"
RELAY_WORKER_HEARTBEAT_SECONDS="5"
RELAY_WORKER_STALE_SECONDS="20"
# Operational activity expires; safety-critical audit events are always retained.
RELAY_ACTIVITY_RETENTION_DAYS="30"

# Rotating application log.
RELAY_LOG_MAX_BYTES="5242880"
RELAY_LOG_BACKUP_COUNT="5"

# Optional labels used in the Codex conversation envelope.
RELAY_CODEX_DISPLAY_NAME="Codex Test"
RELAY_KINDROID_DISPLAY_NAME="Hannah"
# Agent context memory: opt-in only after local/operator acceptance.
RELAY_MEMORY_ENABLED=false
RELAY_MEMORY_AUTO_CAPTURE=false
RELAY_MEMORY_EXTRACTOR=semantic
RELAY_MEMORY_EXTRACTION_TIMEOUT_SECONDS=45
RELAY_MEMORY_MAX_MESSAGES_24H=30
RELAY_MEMORY_MODEL_PATH=
RELAY_MEMORY_MODEL_REVISION=operator-local-v1

# Manual one-shot exploration; enable only after operator acceptance.
# Manual and scheduled invitations share this ceiling; failures spend the attempt budget.
RELAY_EXPLORATION_ENABLED=false
RELAY_EXPLORATION_MAX_SESSIONS_24H=3
# New invitations only: isolated semantic interpretation, source links and bounded acknowledgement.
# Existing sessions require the dashboard's explicit Interpret response action.
RELAY_EXPLORATION_AUTO_INTERPRET=true

# Independent curiosity scheduling (serve host only). No research or identity promotion.
# Both EXPLORATION_ENABLED and CURIOSITY_ENABLED must be true; enable deliberately.
RELAY_CURIOSITY_ENABLED=false
# System-local fixed hours; blank selects interval mode instead. No missed-slot catch-up.
RELAY_CURIOSITY_SCHEDULE_HOURS=10,16
RELAY_CURIOSITY_INTERVAL_SECONDS=21600
RELAY_CURIOSITY_JITTER_SECONDS=1800
RELAY_CURIOSITY_QUIET_HOURS=22:00-08:00
RELAY_CURIOSITY_IDLE_SECONDS=1800
RELAY_CURIOSITY_MAX_ATTEMPTS_24H=2
# Conservatively reserves two interpreter calls per automatic-response session.
RELAY_CURIOSITY_MAX_INTERPRETATIONS_24H=4
RELAY_CURIOSITY_WINDOW_SECONDS=180
